CREATE TABLE Orders(
OrderID INT PRIMARY KEY IDENTITY(1, 1),
CustomerName VARCHAR(100),
Quantity INT,
OrderDate DATE,
ProductId INT,
FOREIGN KEY (ProductId) REFERENCES Products(ProductId)
)
