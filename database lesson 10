--procedure without parameters
CREATE PROCEDURE ShowProducts AS
BEGIN
	SELECT * FROM Products
END
EXEC ShowProducts

CREATE PROCEDURE ShowOrders AS
BEGIN
	SELECT * FROM Orders
END
EXEC ShowOrders

--procedure with parameters
CREATE PROCEDURE GetProductsByPrice
	@MinPrice DECIMAL (10, 2)
AS
BEGIN
	SELECT * FROM Products 
	WHERE Price >= @MinPrice
END
EXEC GetProductsByPrice @MinPrice = 300

CREATE PROCEDURE GetOrdersByCustomers 
	@CustomerName VARCHAR(100) 
AS
BEGIN
	SELECT OrderID, CustomerName FROM Orders
	WHERE CustomerName = @CustomerName
END
EXEC GetOrdersByCustomers @CustomerName = 'Alice'

--count how many orders a product has
CREATE PROCEDURE CountOrdersForProduct
	@ProductID INT, 
	@TotalOrders INT OUTPUT
AS
BEGIN
	SELECT @TotalOrders = COUNT(*) FROM Orders
	WHERE ProductId = @ProductID
END

DECLARE @RESULT INT

EXEC CountOrdersForProduct 
@ProductID = 1,
@TotalOrders = @RESULT OUTPUT
SELECT @RESULT AS TOTALORDERS

--alter ShowProucts to show prices descending
ALTER PROCEDURE ShowProducts
AS
BEGIN
	SELECT * FROM Products
	ORDER BY Price DESC
END

EXEC ShowProducts

ALTER PROCEDURE GetOrdersByCustomers AS
BEGIN
	SELECT * FROM Orders
	ORDER BY OrderDate DESC
END

EXEC GetOrdersByCustomers 

DROP PROCEDURE ShowOrders
